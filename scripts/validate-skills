#!/usr/bin/env python3
import argparse
import sys

from repository_tools import (
    ValidationError,
    repository_root,
    skill_files,
    validate_skill_file,
)


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate every skill package in a repository")
    parser.add_argument("root", nargs="?", help="repository root; defaults to this checkout")
    arguments = parser.parse_args()
    root = repository_root(arguments.root, __file__)

    try:
        files = skill_files(root)
    except ValidationError as error:
        print(error, file=sys.stderr)
        return 1

    errors = [
        error
        for skill_file in files
        for error in validate_skill_file(skill_file)
    ]
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print(f"Validated {len(files)} skill{'s' if len(files) != 1 else ''}.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
